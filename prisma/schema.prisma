generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ----------------------------
// Enums
// ----------------------------

enum UserRole {
  ADMIN
  USER
}

enum AuditAction {
  REGISTER_USER
  LOGIN_USER
  LOGOUT_USER
  RECOVER_PASSWORD
  CHANGE_PASSWORD
  UPDATE_USER
  INACTIVATE_USER
  REACTIVATE_USER
  CREATE_TASK
  UPDATE_TASK
  INACTIVATE_TASK
  CREATE_COMMENT
  UPDATE_COMMENT
  INACTIVATE_COMMENT
  UPDATE_COLOR_CATEGORY
  DELETE_CATEGORY
  ASSIGN_TASK
  UNASSIGN_TASK
  UPDATE_COLOR_STATUS
  DELETE_STATUS
  CREATE_WORKSPACE
  UPDATE_WORKSPACE
  INACTIVATE_WORKSPACE
  ADD_WORKSPACE_MEMBER
  REMOVE_WORKSPACE_MEMBER
  CHANGE_WORKSPACE_ROLE
  CREATE_TASK_ROLE
  UPDATE_TASK_ROLE
  DELETE_TASK_ROLE
}

enum AuditEntity {
  Task
  Category
  User
  Status
  TaskAssignee
  Comment
  Workspace
  WorkspaceMember
  TaskRole
}

enum AuthProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum DocumentType {
  DNI
  PASSPORT
  DRIVER_LICENSE
}

enum WorkspacePermission {
  WORKSPACE_UPDATE
  MEMBER_INVITE
  MEMBER_REMOVE
  ROLE_MANAGE
  STATUS_MANAGE
  CATEGORY_MANAGE
  TASK_CREATE
  TASK_UPDATE
  TASK_DELETE
  TASK_ASSIGN
  COMMENT_CREATE
  COMMENT_DELETE_ANY
}

enum TaskPermission {
  TASK_UPDATE
  TASK_CHANGE_STATUS
  TASK_ASSIGN
  COMMENT_CREATE
  COMMENT_DELETE_ANY
}

// ----------------------------
// Models
// ----------------------------

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entity      AuditEntity
  entityId    String // primary affected record id
  before      Json? // snapshot before the change
  after       Json? // snapshot after the change
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId]) // query all logs for a specific record
  @@index([action]) // filter by action type
}

model User {
  id                String       @id @default(uuid())
  name              String
  firstSurname      String
  secondSurname     String?
  role              UserRole     @default(USER)
  documentType      DocumentType
  documentNumber    String
  code              String       @unique
  email             String
  phoneNumber       String?
  phoneCountryCode  String?
  password          String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  active            Boolean      @default(true)
  /// Tokens issued before this moment are rejected (ends every session at once).
  sessionsRevokedAt DateTime?
  /// Deadline to recover a deleted account. Null while the account is active.
  recoveryDate      DateTime?
  /// Set once the recovery deadline passed: frees the email and document for a new account.
  releasedAt        DateTime?
  source            AuthProvider
  createdTasks      Task[]       @relation("TasksCreated")

  comments             Comment[]
  commentReplies       CommentReply[]
  auditLogs            AuditLog[]
  revokedTokens        RevokedToken[]
  ownedWorkspaces      Workspace[]
  workspaceMemberships WorkspaceMember[] @relation("WorkspaceMemberships")
  workspaceInvites     WorkspaceMember[] @relation("WorkspaceInvites")
  assignedTasks        TaskAssignee[]    @relation("TaskAssignments")
  tasksAssignedByMe    TaskAssignee[]    @relation("TaskAssignedBy")

  /// Email and document are unique among accounts that are not released (active or still recoverable).
  /// A document number is unique per document type (the same number can exist under another type).
  @@unique([email], where: raw("\"releasedAt\" IS NULL"))
  @@unique([documentType, documentNumber], where: raw("\"releasedAt\" IS NULL"))
}

model Workspace {
  id               String    @id @default(uuid())
  name             String
  code             String
  taskPrefix       String
  lastTaskSequence Int       @default(0)
  description      String?
  isDefault        Boolean   @default(false)
  active           Boolean   @default(true)
  /// Deadline to recover a deleted workspace. Null while the workspace is active.
  recoveryDate     DateTime?
  /// Set once the recovery deadline passed: frees the name for a new workspace.
  releasedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks          Task[]
  statuses       Status[]
  categories     Category[]
  members        WorkspaceMember[]
  workspaceRoles WorkspaceRole[]
  taskRoles      TaskRole[]

  @@unique([ownerId, code])
  @@unique([ownerId, taskPrefix])
  /// The name is unique per owner among workspaces that are not released (active or still recoverable).
  @@unique([ownerId, name], where: raw("\"releasedAt\" IS NULL"))
  @@index([ownerId, active])
}

model WorkspaceRole {
  id          String                @id @default(uuid())
  name        String
  description String?
  permissions WorkspacePermission[]
  isSystem    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  members WorkspaceMember[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  joinedAt    DateTime @default(now())

  roleId String
  role   WorkspaceRole @relation(fields: [roleId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  invitedById String?
  invitedBy   User?   @relation("WorkspaceInvites", fields: [invitedById], references: [id], onDelete: SetNull)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([roleId])
}

model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId])
}

model Task {
  id             String    @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  active         Boolean   @default(true)
  sequenceNumber Int

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TasksCreated", fields: [createdById], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  statusId  String?
  status    Status?        @relation(fields: [statusId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]
  comments  Comment[]

  @@unique([workspaceId, sequenceNumber])
  @@index([workspaceId, active, createdAt])
  @@index([createdById])
  @@index([categoryId])
  @@index([statusId])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model Status {
  id        String   @id @default(uuid())
  name      String
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId, createdAt])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edited    Boolean  @default(false)
  active    Boolean  @default(true)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  replies CommentReply[]

  @@index([taskId, active, createdAt])
  @@index([userId])
}

model CommentReply {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  edited    Boolean  @default(false)
  active    Boolean  @default(true)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([commentId, active, createdAt])
  @@index([userId])
}

model TaskRole {
  id          String           @id @default(uuid())
  name        String
  description String?
  permissions TaskPermission[]
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  assignees TaskAssignee[]

  @@unique([workspaceId, name])
}

model TaskAssignee {
  taskId     String
  userId     String
  assignedAt DateTime @default(now())

  assignedById String?
  assignedBy   User?   @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskAssignments", fields: [userId], references: [id], onDelete: Cascade)

  roleId String
  role   TaskRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([taskId, userId])
  @@index([userId])
}
